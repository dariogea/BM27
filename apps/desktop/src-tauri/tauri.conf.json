{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BM27",
  "version": "0.1.0-alpha.15",
  "identifier": "com.bm27.game",
  "build": {
    "beforeDevCommand": "pnpm --filter @bm27/web dev",
    "beforeBuildCommand": "pnpm --filter @bm27/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BM27 — Basketball Manager 2027",
        "width": 1366,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Basketball Manager 2027",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
