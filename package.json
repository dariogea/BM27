{
  "name": "bm27",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @bm27/web build",
    "web": "pnpm --filter @bm27/web dev",
    "sim": "pnpm --filter @bm27/cli sim",
    "bench": "pnpm --filter @bm27/cli bench",
    "schema:export": "pnpm --filter @bm27/schema export-json-schema",
    "calibrate": "pnpm --filter @bm27/cli calibrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
