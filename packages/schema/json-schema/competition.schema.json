{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rulesetId": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "type": "object",
      "properties": {
        "groupCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "roundRobinLegs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "playoffs": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "qualifiersPerGroup": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "seriesBestOf": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  }
                }
              },
              "required": [
                "qualifiersPerGroup",
                "seriesBestOf"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "groupCount",
        "roundRobinLegs",
        "playoffs"
      ],
      "additionalProperties": false
    },
    "promotionSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "relegationSlots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "teamIds": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "salaryCap": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "minSalary": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rosterMin": {
      "type": "integer",
      "minimum": 5,
      "maximum": 9007199254740991
    },
    "rosterMax": {
      "type": "integer",
      "minimum": 5,
      "maximum": 9007199254740991
    },
    "economy": {
      "type": "object",
      "properties": {
        "tvRevenue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sponsorRevenue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ticketPrice": {
          "type": "number",
          "minimum": 0
        },
        "averageAttendance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fixedCosts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wageShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "baseReputation": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "tvRevenue",
        "sponsorRevenue",
        "ticketPrice",
        "averageAttendance",
        "fixedCosts",
        "wageShare",
        "baseReputation"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "level",
    "rulesetId",
    "format",
    "promotionSlots",
    "relegationSlots",
    "teamIds",
    "salaryCap",
    "minSalary",
    "rosterMin",
    "rosterMax",
    "economy"
  ],
  "additionalProperties": false
}
