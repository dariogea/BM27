{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 8
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "config": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "regions": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "rosterSize": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 5,
              "maximum": 30
            },
            "max": {
              "type": "integer",
              "minimum": 5,
              "maximum": 30
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "levels": {
          "minItems": 1,
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "competitionId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "rulesetId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "teamCount": {
                "type": "integer",
                "minimum": 2,
                "maximum": 512
              },
              "averageQuality": {
                "type": "number",
                "minimum": 1,
                "maximum": 99
              },
              "format": {
                "type": "object",
                "properties": {
                  "groupCount": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "roundRobinLegs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4
                  },
                  "playoffs": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "qualifiersPerGroup": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "seriesBestOf": {
                            "minItems": 1,
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9007199254740991
                            }
                          }
                        },
                        "required": [
                          "qualifiersPerGroup",
                          "seriesBestOf"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "groupCount",
                  "roundRobinLegs",
                  "playoffs"
                ],
                "additionalProperties": false
              },
              "promotionSlots": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "relegationSlots": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "salaryCap": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "minSalary": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "economy": {
                "type": "object",
                "properties": {
                  "tvRevenue": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "sponsorRevenue": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "ticketPrice": {
                    "type": "number",
                    "minimum": 0
                  },
                  "averageAttendance": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "fixedCosts": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "wageShare": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "baseReputation": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "tvRevenue",
                  "sponsorRevenue",
                  "ticketPrice",
                  "averageAttendance",
                  "fixedCosts",
                  "wageShare",
                  "baseReputation"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "competitionId",
              "name",
              "level",
              "rulesetId",
              "teamCount",
              "averageQuality",
              "format",
              "promotionSlots",
              "relegationSlots",
              "salaryCap",
              "minSalary",
              "economy"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "regions",
        "rosterSize",
        "levels"
      ],
      "additionalProperties": false
    },
    "rulesets": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "periods": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "periodMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "overtimeMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 15
          },
          "personalFoulLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "teamFoulsForBonus": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "timeoutsFirstHalf": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "timeoutsSecondHalf": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "timeoutsOvertime": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "technicalFoulsForEjection": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "shotClockSeconds": {
            "type": "integer",
            "minimum": 10,
            "maximum": 60
          },
          "shotClockOffensiveReboundSeconds": {
            "type": "integer",
            "minimum": 5,
            "maximum": 60
          }
        },
        "required": [
          "id",
          "name",
          "periods",
          "periodMinutes",
          "overtimeMinutes",
          "personalFoulLimit",
          "teamFoulsForBonus",
          "timeoutsFirstHalf",
          "timeoutsSecondHalf",
          "timeoutsOvertime",
          "technicalFoulsForEjection",
          "shotClockSeconds",
          "shotClockOffensiveReboundSeconds"
        ],
        "additionalProperties": false
      }
    },
    "names": {
      "type": "object",
      "properties": {
        "cities": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "region": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "name",
              "region"
            ],
            "additionalProperties": false
          }
        },
        "teamNicknames": {
          "minItems": 1,
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "firstNames": {
          "minItems": 1,
          "maxItems": 2048,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "lastNames": {
          "minItems": 1,
          "maxItems": 2048,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        }
      },
      "required": [
        "cities",
        "teamNicknames",
        "firstNames",
        "lastNames"
      ],
      "additionalProperties": false
    },
    "clubs": {
      "minItems": 2,
      "maxItems": 512,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "competitionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "identity": {
            "type": "object",
            "properties": {
              "referenceName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "source": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "catalogId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "clubId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "capturedOn": {
                        "type": "string",
                        "format": "date",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                      },
                      "verification": {
                        "type": "string",
                        "enum": [
                          "unverified",
                          "declared-verified"
                        ]
                      }
                    },
                    "required": [
                      "catalogId",
                      "clubId",
                      "url",
                      "capturedOn",
                      "verification"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "referenceName",
              "source"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "name",
          "city",
          "region",
          "competitionId",
          "identity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "schemaVersion",
    "id",
    "name",
    "description",
    "config",
    "rulesets",
    "names"
  ],
  "additionalProperties": false
}
