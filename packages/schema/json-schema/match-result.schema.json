{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seasonNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "competitionId": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "enum": [
        "regular",
        "playoff"
      ]
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "homeTeamId": {
      "type": "string",
      "minLength": 1
    },
    "awayTeamId": {
      "type": "string",
      "minLength": 1
    },
    "homeScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "awayScore": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "overtimePeriods": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "seasonNumber",
    "competitionId",
    "stage",
    "round",
    "homeTeamId",
    "awayTeamId",
    "homeScore",
    "awayScore",
    "overtimePeriods"
  ],
  "additionalProperties": false
}
