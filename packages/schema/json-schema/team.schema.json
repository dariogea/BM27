{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "referenceName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "source": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "catalogId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "clubId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "capturedOn": {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    "verification": {
                      "type": "string",
                      "enum": [
                        "unverified",
                        "declared-verified"
                      ]
                    }
                  },
                  "required": [
                    "catalogId",
                    "clubId",
                    "url",
                    "capturedOn",
                    "verification"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "referenceName",
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "city": {
      "type": "string",
      "minLength": 1
    },
    "region": {
      "type": "string",
      "minLength": 1
    },
    "playerIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tactics": {
      "type": "object",
      "properties": {
        "pace": {
          "type": "string",
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "offenseFocus": {
          "type": "string",
          "enum": [
            "inside",
            "balanced",
            "perimeter"
          ]
        },
        "defenseScheme": {
          "type": "string",
          "enum": [
            "man",
            "zone"
          ]
        },
        "pickAndRollCoverage": {
          "type": "string",
          "enum": [
            "drop",
            "switch",
            "hedge",
            "blitz"
          ]
        },
        "pressure": {
          "type": "string",
          "enum": [
            "low",
            "normal",
            "high"
          ]
        },
        "offensiveRebounding": {
          "type": "string",
          "enum": [
            "get-back",
            "normal",
            "crash"
          ]
        },
        "rotationDepth": {
          "type": "integer",
          "minimum": 7,
          "maximum": 12
        }
      },
      "required": [
        "pace",
        "offenseFocus",
        "defenseScheme",
        "pickAndRollCoverage",
        "pressure",
        "offensiveRebounding",
        "rotationDepth"
      ],
      "additionalProperties": false
    },
    "rotation": {
      "anyOf": [
        {
          "minItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "reputation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "finance": {
      "type": "object",
      "properties": {
        "balance": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "lastRevenue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "balance",
        "lastRevenue"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "name",
    "identity",
    "city",
    "region",
    "playerIds",
    "tactics",
    "rotation",
    "reputation",
    "finance"
  ],
  "additionalProperties": false
}
