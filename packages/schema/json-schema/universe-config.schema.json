{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "regions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rosterSize": {
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 5,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 5,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "levels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "competitionId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rulesetId": {
            "type": "string",
            "minLength": 1
          },
          "teamCount": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          },
          "averageQuality": {
            "type": "number",
            "minimum": 1,
            "maximum": 99
          },
          "format": {
            "type": "object",
            "properties": {
              "groupCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "roundRobinLegs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "playoffs": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "qualifiersPerGroup": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 9007199254740991
                      },
                      "seriesBestOf": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        }
                      }
                    },
                    "required": [
                      "qualifiersPerGroup",
                      "seriesBestOf"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "groupCount",
              "roundRobinLegs",
              "playoffs"
            ],
            "additionalProperties": false
          },
          "promotionSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "relegationSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "salaryCap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "minSalary": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "competitionId",
          "name",
          "level",
          "rulesetId",
          "teamCount",
          "averageQuality",
          "format",
          "promotionSlots",
          "relegationSlots",
          "salaryCap",
          "minSalary"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "regions",
    "rosterSize",
    "levels"
  ],
  "additionalProperties": false
}
